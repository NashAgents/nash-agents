[Unit]
Description=Nash Cluster Coordinator
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=nash
Group=nash
WorkingDirectory=/opt/nash-agents
EnvironmentFile=/etc/nash/nash-cluster.env
ExecStart=/usr/bin/node /opt/nash-agents/dist/index.js cluster start --host 127.0.0.1 --port 18444 --web-dist /opt/nash-agents/apps/web/dist --worker
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=30s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
