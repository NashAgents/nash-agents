[Unit]
Description=Nash Worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=nash
Group=nash
WorkingDirectory=/opt/nash-agents
EnvironmentFile=/etc/nash/nash-worker.env
ExecStart=/usr/bin/node /opt/nash-agents/dist/index.js node start
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=78
KillMode=control-group
TimeoutStopSec=30s
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
